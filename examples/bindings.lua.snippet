-- Add to ~/.config/hypr/bindings.lua
-- Pick any free key combo -- SUPER + SHIFT + W is just what I used; on a
-- stock Omarchy install it's bound to Omawrite by default, so unbind it
-- first if you want this exact key:
--   hl.unbind("SUPER + SHIFT + W")

o.bind("SUPER + SHIFT + W", "Wallpaper picker", "omarchy-wallpaper-picker")
